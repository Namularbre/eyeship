---
source: crates/eyeship-report/src/sarif.rs
expression: "sarif(&real_report(), None)"
---
{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "eyeship",
          "version": "0.1.0",
          "informationUri": "https://github.com/Namularbre/eyeship",
          "rules": [
            {
              "id": "R001",
              "shortDescription": {
                "text": "depends_on without health condition"
              },
              "fullDescription": {
                "text": "With the short list syntax or `condition: service_started`, the dependent service starts as soon as its dependency is launched, not when it is ready. It gets connection refused at startup and crashes."
              },
              "help": {
                "text": "Use `condition: service_healthy` and give the dependency a healthcheck."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "R006",
              "shortDescription": {
                "text": "No memory limit"
              },
              "fullDescription": {
                "text": "Without `mem_limit` or `deploy.resources.limits.memory`, a memory leak in one container fills the host RAM, and the kernel OOM killer may kill other services (often the database) instead of the leaking one."
              },
              "help": {
                "text": "Set `mem_limit` (or `deploy.resources.limits.memory`) to a value above the normal peak usage of the service."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "R009",
              "shortDescription": {
                "text": "Published port conflict"
              },
              "fullDescription": {
                "text": "Two containers publish the same host port with the same protocol on overlapping host IPs. Only one can bind it: the other fails to start with 'port is already allocated', and the deployment is left half up."
              },
              "help": {
                "text": "Publish each host port once: pick a different host port, bind to distinct host IPs, or let a single reverse proxy publish the port."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "R017",
              "shortDescription": {
                "text": "Obsolete version key"
              },
              "fullDescription": {
                "text": "The root `version` key is ignored by Compose v2, which prints a warning on every command: it is noise that hides real warnings and suggests a file format that no longer exists."
              },
              "help": {
                "text": "Remove the root `version` key."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "artifacts": [
        {
          "location": {
            "uri": "infra/compose%20prod.yaml"
          }
        }
      ],
      "results": [
        {
          "ruleId": "R009",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "message of R009"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "infra/compose%20prod.yaml"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 7
                }
              },
              "logicalLocations": [
